<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp" android:background="#FFF4EA">
    <TextView android:id="@+id/widget_brand" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="dayline · мой день" android:textStyle="bold" android:textColor="#8B500C" android:textSize="18sp" />
    <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#28180E" android:textSize="12sp" android:layout_marginTop="4dp" />
    <TextView android:id="@+id/widget_tasks" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#28180E" android:textSize="16sp" android:layout_marginTop="12dp" />
    <TextView android:id="@+id/widget_news" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:textColor="#28180E" android:textSize="14sp" android:maxLines="3" android:ellipsize="end" android:layout_marginTop="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_alarm" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#28180E" android:textSize="12sp" />
        <Button android:id="@+id/widget_add" android:layout_width="wrap_content" android:layout_height="48dp" android:text="+ Задача" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
